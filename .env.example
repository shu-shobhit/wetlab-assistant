# Copy to .env and fill in. .env is gitignored and must never be committed.
RIME_API_KEY=your_rime_key_here
OPENROUTER_API_KEY=your_openrouter_key_here

# livekit-server --dev prints these; they are the published dev defaults.
# Media stays on loopback, so these stay as the dev pair: webserver.py mints room
# tokens with them and the dev server accepts no others.
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# A LiveKit Cloud project, used only to authenticate the inference gateway at
# agent-gateway.livekit.cloud: recognition, turn detection and adaptive
# interruption. The agents library reads these first and falls back to
# LIVEKIT_API_KEY, and the dev pair above is rejected there with a 401. Without
# them recognition does not work at all, so unlike turn detection this is not a
# setting you can leave empty and still have a product.
LIVEKIT_INFERENCE_API_KEY=
LIVEKIT_INFERENCE_API_SECRET=

# The project's websocket URL. Not read by the agent, which talks to LIVEKIT_URL.
# Recorded so the project behind the inference credentials is identifiable.
LIVEKIT_CLOUD_URL=

# Validated with ~/.claude/skills/rime/scripts/check_pairing.py luna mistv3 eng,
# because Rime does not reliably reject a bad speaker/model/lang triple: it often
# returns plausible audio in the wrong voice instead.
#
# Do not leave this empty. The plugin then falls back to its own default, cove,
# and the product speaks in a voice nothing was measured on. The round trip in
# RIME_EVIDENCE.md is scored on the speaker named here, so changing it changes a
# reported result and the round trip has to be re-run.
RIME_SPEAKER=luna

# The streaming recogniser, named as provider/model for the inference gateway
# above. This is not an OpenRouter model name; the two namespaces look alike and
# naming the wrong one fails when the socket opens rather than at startup. The
# same recogniser scores the round trip in the evidence, so changing it changes
# a reported result.
STT_MODEL=deepgram/nova-3

# The conversational model, named for OpenRouter. Three were run through the
# same spoken walkthrough and the logs are under runs/evidence/; this is the
# fastest of them, and the only one of the three that announces an expiring
# timer. anthropic/claude-sonnet-4.6 answers 400 to an announcement, because it
# refuses a conversation that ends with an assistant message and that is when an
# announcement is requested. See RIME_EVIDENCE.md section 2a.
LLM_MODEL=deepseek/deepseek-v4-flash

# How much that model may think before it answers, as OpenRouter's `reasoning`
# parameter: off, minimal, low, medium, high, or left unset to say nothing about
# it and let the model keep its own default. Most of the response time in claim
# 2 is the model, so this is the one latency knob that is not a design change.
#
# `off` is not available on every model. z-ai/glm-5.3-flash answers 400,
# "Reasoning is mandatory for this endpoint and cannot be disabled"; use
# `minimal` there, which returns zero reasoning tokens.
# LLM_REASONING=minimal

# Which OpenRouter providers may serve that model, in preference order, or unset
# to let OpenRouter route. It routes on price against speed, and the cheap hosts
# are the slow ones: measured on this agent's own prompt, deepseek-v4-flash
# reaches its first token in 0.84 s on baidu/fp8 and 1.83 s left to route, and
# the routed one dropped a tool call. Name two, so a provider that is busy
# degrades to the other rather than failing the turn. Slugs come from
# https://openrouter.ai/api/v1/models/<model>/endpoints
LLM_PROVIDER=baidu/fp8,alibaba/fp8
